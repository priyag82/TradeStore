package com.tradestore.repository {
    interface TradeRepository {
        <<Repository>>
        + findById(tradeId): Optional<Trade>
        + save(trade): Trade
        + findAll(): List<Trade>
        + findTradesToExpireBatch(currentDate, pageable): List<Trade>
        + findByCounterPartyId(counterPartyId, pageable): Page<Trade>
        + countByExpired(expired): long
    }
    
    interface AuditMessageRepository {
        <<Repository>>
        + findById(id): Optional<AuditMessage>
        + save(auditMessage): AuditMessage
        + findAll(): List<AuditMessage>
    }
}

