        - String bookId
        - LocalDate maturityDate
        - LocalDate createdDate
        - String expired
        - LocalDate timestamp
        - LocalDate lastUpdated
        --
        + Trade()
        + Trade(tradeId, version, counterPartyId, bookId, maturityDate, createdDate, expired)
