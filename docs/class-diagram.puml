        + setTradeId(tradeId): void
        + getVersion(): Integer
        + setVersion(version): void
        + getCounterPartyId(): String
        + setCounterPartyId(counterPartyId): void
        + getBookId(): String
        + setBookId(bookId): void
        + getMaturityDate(): LocalDate
        + setMaturityDate(maturityDate): void
        + getCreatedDate(): LocalDate
        + setCreatedDate(createdDate): void
        + getExpired(): String
        + setExpired(expired): void
