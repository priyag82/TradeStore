}

package com.tradestore.dto {
    class TradeMessage {
        - UUID tradeId
        - Integer version
        - String counterPartyId
        - String bookId
        - LocalDate maturityDate
        - LocalDate createdDate
        - String expired
        --
        + TradeMessage()
        + getTradeId(): UUID
        + setTradeId(tradeId): void
        + getVersion(): Integer
        + setVersion(version): void
        + getCounterPartyId(): String
        + setCounterPartyId(counterPartyId): void
        + getBookId(): String
