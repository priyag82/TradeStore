package com.tradestore.repository {
    interface TradeRepository {
        <<Repository>>
        + findById(tradeId): Optional<Trade>
        + save(trade): Trade
        + findAll(): List<Trade>
        + findByMaturityDateBeforeAndExpired(currentDate, expiredFlag): List<Trade>
        + existsByTradeId(tradeId): boolean
    }
    
    interface AuditMessageRepository {
        <<Repository>>
        + findById(id): Optional<AuditMessage>
        + save(auditMessage): AuditMessage
        + findAll(): List<AuditMessage>
    }
}

package com.tradestore.service {
    class TradeService {
        - TradeRepository tradeRepository
        - Logger logger
        --
        + processTrade(trade): Trade
        + markExpiredTrades(): void
        + getTrade(tradeId): Optional<Trade>
        + getAllTrades(): List<Trade>
        --
        - validateMaturityDate(trade): void
        - validateVersion(trade): void
    }
    
    class KafkaTradeConsumer {
        - TradeService tradeService
        - AuditMessageRepository auditMessageRepository
        - ObjectMapper objectMapper
        --
        + consumeTradeMessage(message, topic, partition, offset, messageKey, consumerRecord, acknowledgment): void
        --
        - createAuditMessage(message, topic, partition, offset): AuditMessage
        - convertToTrade(tradeMessage): Trade
    }
}

package com.tradestore.exception {
    class InvalidTradeException {
        + InvalidTradeException(message)
        + InvalidTradeException(message, cause)
    }
}

package com.tradestore.config {
    class DatabaseConfig {
        <<Configuration>>
    }
    
    class KafkaConfig {
        <<Configuration>>
        - String bootstrapServers
        - String groupId
        --
        + consumerFactory(): ConsumerFactory
        + kafkaListenerContainerFactory(): ConcurrentKafkaListenerContainerFactory
    }
}

' Relationships
TradeMessage ..> Trade : "JSON mapping"
TradeService --> TradeRepository : "uses"
TradeService --> Trade : "processes"
KafkaTradeConsumer --> TradeService : "delegates to"
KafkaTradeConsumer --> AuditMessageRepository : "uses"
KafkaTradeConsumer --> TradeMessage : "consumes"
KafkaTradeConsumer --> AuditMessage : "creates"
TradeRepository --> Trade : "manages"
AuditMessageRepository --> AuditMessage : "manages"
TradeService --> InvalidTradeException : "throws"

' JPA Annotations
note top of Trade
  @Entity
  @Table(name = "trades")
  @EntityListeners(AuditingEntityListener.class)
end note

note top of AuditMessage
  @Document(collection = "audit_messages")
end note

' Spring Annotations
note top of TradeRepository
  @Repository
  extends JpaRepository<Trade, UUID>
end note

note top of AuditMessageRepository
  @Repository
  extends MongoRepository<AuditMessage, String>
end note

note top of TradeService
  @Service
  @Transactional
  @Scheduled(cron = "0 0 0 * * *")
end note

note top of KafkaTradeConsumer
  @Service
  @KafkaListener(topics = "tradestore")
end note

@enduml
