@startuml Trade Store Deployment Diagram

title Trade Store Service - Deployment Architecture

!define RECTANGLE class
!define CLOUD cloud

' Environments
CLOUD "Production Environment" as ProdEnv {
    rectangle "Load Balancer\n(nginx/ALB)" as LB
    
    rectangle "Trade Store App 1\nSpring Boot\nPort: 8080" as App1
    rectangle "Trade Store App 2\nSpring Boot\nPort: 8080" as App2
    rectangle "Trade Store App 3\nSpring Boot\nPort: 8080" as App3
    
    database "PostgreSQL\nPrimary\nPort: 5432" as PG_Prod
    database "PostgreSQL\nReplica\nPort: 5432" as PG_Replica
    
    database "MongoDB\nCluster\nPort: 27017" as Mongo_Prod
    
    rectangle "Kafka Cluster\n3 Brokers\nPort: 9092" as Kafka_Prod
    
    rectangle "Prometheus\nMetrics Server\nPort: 9090" as Prometheus_Prod
    rectangle "Grafana\nDashboard\nPort: 3000" as Grafana_Prod
}

CLOUD "Development Environment" as DevEnv {
    rectangle "Trade Store Dev\nSpring Boot\nPort: 8080" as App_Dev
    
    database "H2 Database\nIn-Memory\nPort: 9092" as H2_Dev
    
    database "MongoDB\nSingle Instance\nPort: 27017" as Mongo_Dev
    
    rectangle "Kafka\nSingle Broker\nPort: 9092" as Kafka_Dev
}

CLOUD "CI/CD Pipeline" as CICD {
    rectangle "Git Repository\n(GitHub/GitLab)" as Git
    rectangle "Maven Build\nmvn clean package" as Maven
    rectangle "Docker Registry\n(Docker Hub/ECR)" as DockerReg
    rectangle "Kubernetes\nCluster" as K8s
}

' External Systems
rectangle "External Clients\n(Web/Mobile/API)" as Clients
rectangle "External Systems\n(Trade Platforms)" as ExternalSystems

' Connections in Production
Clients --> LB : HTTPS
LB --> App1 : HTTP
LB --> App2 : HTTP
LB --> App3 : HTTP

App1 --> PG_Prod : JDBC
App2 --> PG_Prod : JDBC
App3 --> PG_Prod : JDBC

App1 --> PG_Replica : JDBC (Read)
App2 --> PG_Replica : JDBC (Read)
App3 --> PG_Replica : JDBC (Read)

App1 --> Mongo_Prod : MongoDB Driver
App2 --> Mongo_Prod : MongoDB Driver
App3 --> Mongo_Prod : MongoDB Driver

App1 --> Kafka_Prod : Kafka Producer/Consumer
App2 --> Kafka_Prod : Kafka Producer/Consumer
App3 --> Kafka_Prod : Kafka Producer/Consumer

ExternalSystems --> Kafka_Prod : Publish Trade Events

Prometheus_Prod --> App1 : /actuator/prometheus
Prometheus_Prod --> App2 : /actuator/prometheus
Prometheus_Prod --> App3 : /actuator/prometheus

Grafana_Prod --> Prometheus_Prod : Query Metrics

' Connections in Development
Clients --> App_Dev : HTTP
App_Dev --> H2_Dev : JDBC
App_Dev --> Mongo_Dev : MongoDB Driver
App_Dev --> Kafka_Dev : Kafka Producer/Consumer

' CI/CD Flow
Git --> Maven : Source Code
Maven --> DockerReg : Docker Images
DockerReg --> K8s : Deploy
K8s --> ProdEnv : Production Deployment
K8s --> DevEnv : Development Deployment

' Configuration Management
note top of App1
  - Spring Profiles: prod
  - Environment Variables
  - Health Checks: /actuator/health
  - Metrics: /actuator/metrics
end note

note top of App_Dev
  - Spring Profiles: dev
  - H2 Console: /h2-console
  - Debug Mode Enabled
  - Hot Reload
end note

note right of PG_Prod
  - Connection Pooling
  - Backups Daily
  - SSL/TLS Enabled
  - Read Replicas
end note

note right of Kafka_Prod
  - Topic: tradestore
  - Replication Factor: 3
  - Partitions: 6
  - Retention: 7 days
end note

note bottom of CICD
  - Automated Testing
  - Security Scanning
  - Blue-Green Deployment
  - Rollback Capability
end note

' Styling
skinparam cloud {
    BackgroundColor LightBlue
    BorderColor Blue
}

skinparam rectangle {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}

skinparam database {
    BackgroundColor LightYellow
    BorderColor Orange
}

@enduml
